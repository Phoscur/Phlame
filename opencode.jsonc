{
  "$schema": "https://opencode.ai/config.json",
  // phorge is environment-specific (stdio on the host, HTTP behind the container wall)
  // and project config has the highest precedence of opencode's merged config sources —
  // so it is declared per environment instead: host, see docs/mcp-setup.md; container,
  // generated by tools/agent/setup.sh into ~/.config/opencode/opencode.json.
  "mcp": {},
}
